# Stripe Configuration
# Get from https://dashboard.stripe.com/apikeys
# This is a Vite app: only VITE_-prefixed vars are exposed to client code
# (import.meta.env.VITE_*). NEXT_PUBLIC_ vars are a Next.js convention and
# are never bundled here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs
VITE_STRIPE_PRICE_PRO_MONTHLY=price_xxx
VITE_STRIPE_PRICE_PRO_ANNUAL=price_xxx
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
VITE_STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxx

# Environment
NODE_ENV=development
MODEL_DATA_DIR=./data/model
MODEL_CHANGELOG_PATH=./data/model/changelog.json
MODEL_FLAGS_PATH=./data/model/flags.json
MODEL_ASSUMPTIONS_PATH=./data/model/assumptions.json

# Server (server/index.mjs) — Postgres, sessions, admin auth
DATABASE_URL=postgres://user:password@localhost:5432/dda
# Set to 'false' only for a managed Postgres provider whose certificate isn't
# in the default CA store. Left unset, certs are verified in production.
DATABASE_SSL_REJECT_UNAUTHORIZED=
SESSION_SECRET=
MAGIC_LINK_SECRET=

# Contact form notifications (server/src/services/notify.mjs)
# Every submission is written to contact_submissions regardless; these are
# best-effort delivery on top of that.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
CONTACT_WEBHOOK_URL=
